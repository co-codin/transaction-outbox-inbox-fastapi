API_KEY=change-me
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
GRPC_PORT=50051
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_RETENTION_SECONDS=86400
OUTBOX_CLEANUP_INTERVAL_SECONDS=300
CONSUMER_PREFETCH_COUNT=10
PAYMENT_PROCESSING_MIN_SECONDS=2
PAYMENT_PROCESSING_MAX_SECONDS=5
PAYMENT_SUCCESS_RATE=0.9
WEBHOOK_TIMEOUT_SECONDS=5.0
LOG_LEVEL=INFO
LOG_JSON=true
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=transaction-outbox-inbox
KAFKA_PAYMENTS_TOPIC=payments.events
KAFKA_INBOX_DLQ_TOPIC=payments.inbox.dlq
KAFKA_INBOX_GROUP_ID=payments-inbox
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_STARTUP_TIMEOUT_SECONDS=10
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1
INBOX_PROCESSING_MODE=inline
INBOX_MAX_ATTEMPTS=3
INBOX_BATCH_SIZE=50
INBOX_POLL_INTERVAL_SECONDS=1.0
INBOX_RETRY_BACKOFF_SECONDS=1.0
INBOX_CONSUMER_MAX_RECORDS=20
INBOX_POLL_TIMEOUT_MS=1000
